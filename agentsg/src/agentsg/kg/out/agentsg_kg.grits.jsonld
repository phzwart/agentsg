      },
      "plan_variable": "pplan:vars/concept/tolerance_gated_matching",
      "summary": "Tolerance-gated cell matching: Two cells match when edges and angles stay inside a named tolerance: metric automorphisms, twin laws, and geometric reindexing use 2 percent and 2 degrees; cell comparison uses 3 percent and 5 degrees; a PDB change of basis uses 0.75 percent and 0.5 degrees, and is accepted at a relative metric residual of 1e-6. This is a numeric gate. It is not the exact certificate given by equality over the Selling closure.",
      "agent": "agentsg-kg-builder/0.1 (Claude Fable 5.1, Cowork session, 2026-09-30)"
    },
