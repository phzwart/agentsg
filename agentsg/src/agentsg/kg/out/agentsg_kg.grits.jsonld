      },
      "plan_variable": "pplan:vars/concept/conorm_noise_floor",
      "summary": "Closure-invariant conorm noise floor: One floor s = c \u00b7 \u03c3_\u03b8 \u00b7 T applied to every Selling conorm, where T is the sum of the six conorms. Selling flips permute the conorms and leave T fixed, so the floor is the same on every member of the closure. It is not a separate floor on each pair.",
      "agent": "agentsg-kg-builder/0.1 (Claude Fable 5.1, Cowork session, 2026-09-30)"
    },
